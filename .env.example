# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
#
# Desde F6.4 este fichero se ha partido en dos mitades muy distintas:
#
#   PARTE 1 - INFRAESTRUCTURA. Es lo que el agente lee de verdad en cada
#   arranque: donde esta la base, la clave del modelo, el nivel de log.
#
#   PARTE 2 - PARAMETROS HEREDADOS. Ya NO los lee el ciclo. Los parametros del
#   experimento viven en la tabla `agent_settings`, uno por perfil, y se editan
#   desde la interfaz. Esta seccion solo la usa `run.py import-profile`, que
#   convierte un .env de la version anterior en un perfil, una unica vez.
#
# Para empezar de cero solo hace falta la PARTE 1, crear un perfil y darle
# simbolos. Para migrar de la version anterior, rellena las dos y ejecuta:
#
#       python run.py import-profile --name experimento-01
# ---------------------------------------------------------------------------


# ===========================================================================
# PARTE 1 - INFRAESTRUCTURA
# ===========================================================================

# --- NVIDIA NIM (https://build.nvidia.com -> tu modelo -> Get API Key) ------
# Es la unica clave necesaria: los datos de mercado son de Yahoo (sin clave) y
# el broker es el simulador local.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Base de datos (SQLite local) -------------------------------------------
# Ruta al fichero. Se crea solo, junto con las tablas, en el primer arranque.
DB_PATH=data/trading.db

LOG_LEVEL=INFO

# --- Perfil por defecto -----------------------------------------------------
# Perfil de experimento contra el que operan `cycle` y `status` cuando no se
# pasa `--profile`. Si lo dejas vacio y hay un solo perfil activo, se usa ese;
# con varios activos, el comando exige elegir en lugar de adivinar.
PROFILE=

# --- Dashboard --------------------------------------------------------------
# true = el dashboard muestra el boton de lanzar ciclo. El dashboard sigue
# leyendo la base en solo lectura: el boton arranca `run.py cycle` como proceso
# aparte, no escribe por su cuenta.
#
# PONLO A false si publicas el dashboard fuera de localhost: no hay
# autenticacion, y quien alcance el puerto podria gastar tu cuota del modelo y
# mover la cartera. Con el mapeo por defecto (127.0.0.1:8000) no hay problema.
DASHBOARD_CONTROLS=true

# --- Planificacion (solo la usa el contenedor `scheduler`) ------------------
# Horas de ejecucion en formato HH:MM, separadas por comas.
#
# Con barras diarias:  22:15, poco despues del cierre de Nueva York. Mas de dos
#   ciclos al dia no aporta nada, porque las barras diarias no cambian.
# Con barras horarias: varios durante la sesion, que en hora peninsular va de
#   las 15:30 a las 22:00. Por ejemplo:  16:30,18:30,20:30
#
# Las horas fuera de sesion no gastan nada si el perfil tiene
# skip_when_market_closed activo.
CYCLE_TIMES=22:15
CYCLE_TZ=Europe/Madrid
# true = ejecuta un ciclo al arrancar el contenedor, sin esperar a la hora.
RUN_ON_START=false


# ===========================================================================
# PARTE 2 - PARAMETROS HEREDADOS (solo para `run.py import-profile`)
#
# El ciclo NO lee nada de aqui. Editar estas variables no cambia como opera el
# agente: para eso hay que cambiar los parametros del perfil. Estan porque
# permiten convertir un .env de la version anterior en un perfil sin volver a
# teclearlo todo.
# ===========================================================================

# --- Cartera ----------------------------------------------------------------
# Se convierte en el nombre del perfil si no pasas `--name`.
PORTFOLIO_NAME=experimento-01
# Presupuesto que asignas al agente, en USD.
INITIAL_BUDGET=10000

# --- Modelo -----------------------------------------------------------------
# Modelos probados: meta/llama-3.3-70b-instruct, deepseek-ai/deepseek-r1,
# qwen/qwen2.5-72b-instruct, nvidia/llama-3.3-nemotron-super-49b-v1
LLM_MODEL=meta/llama-3.3-70b-instruct
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- Broker simulado --------------------------------------------------------
# Deslizamiento en puntos basicos, siempre en contra: al comprar se paga mas y al
# vender se cobra menos. 5 pb = 0.05%.
SIM_SLIPPAGE_BPS=5
# Comision por orden en USD. Los brokers americanos no cobran por acciones.
SIM_COMMISSION=0

# --- Que activos se analizan ------------------------------------------------
# Hay dos modos, y son excluyentes.
#
# MODO A: watchlist fija. Se analizan estos y solo estos. Al importar, pasan a
# ser el universo del perfil. Vale la notacion de Yahoo para otros mercados:
#   Espana: SAN.MC, ITX.MC, IBE.MC     Alemania: SAP.DE     Cripto: BTC-USD
WATCHLIST=AAPL,MSFT,NVDA,AMZN,GOOGL,META,AMD,TSLA,JPM,XOM

# MODO B: embudo sobre un universo grande. Si UNIVERSE_FILE tiene valor, la
# watchlist se ignora: un filtro determinista criba el universo entero (segundos,
# cero cuota) y solo los mejores llegan al modelo.
#
# Genera el fichero del S&P 500 con:  python tools/fetch_universe.py
# Descomenta para activarlo:
#UNIVERSE_FILE=universe/sp500.txt

# Cuantos candidatos pasan al modelo. Cada uno es una llamada de ~45 s: 20
# candidatos son unos 15 minutos de ciclo.
SCREENER_TOP_N=20
# score  = puntuacion por tendencia, momento, volumen y volatilidad, penalizando
#          el RSI extremo para no perseguir el precio.
# random = candidatos arbitrarios. Es el GRUPO DE CONTROL: si el agente rinde
#          igual con random, el filtro no esta aportando nada.
SCREENER_MODE=score
# Descartes duros. El de liquidez importa: en un valor ilíquido el simulador
# mentiria, porque supone que se compra a la apertura sin mover el mercado.
SCREENER_MIN_DOLLAR_VOLUME=20000000
SCREENER_MIN_PRICE=5
SCREENER_MAX_VOLATILITY_PCT=120

# --- Intervalo de las barras ------------------------------------------------
# 1d = barras diarias. Un ciclo al dia tras el cierre; los indicadores largos
#      (SMA200) cubren 200 sesiones.
# 1h = barras horarias. Permite 2-3 ciclos por sesion y acumular operaciones
#      cerradas en semanas en vez de meses, que es lo que hace medible la
#      calibracion del modelo. Ojo: SMA200 pasa a ser 200 HORAS (~28 sesiones),
#      y Yahoo solo da ~700 dias de historico intradia.
# Con embudo, el cribado siempre usa barras diarias y solo los seleccionados se
# bajan en el intervalo elegido.
BAR_INTERVAL=1d
# Barras de historico que se pasan al analista.
LOOKBACK_DAYS=200

# --- Calendario de mercado --------------------------------------------------
# true = un ciclo con el mercado cerrado no analiza nada y termina. Evita gastar
# cuota los fines de semana volviendo a decidir sobre datos identicos.
SKIP_WHEN_MARKET_CLOSED=true

# --- Reglas de riesgo -------------------------------------------------------
# El Risk Manager las aplica en codigo, sin IA.
#
# ATENCION: al importar, estos nueve numeros entran como MODO AVANZADO, es decir
# fijados a mano. Los perfiles nuevos, en cambio, los derivan de dos
# deslizadores (perfil de riesgo 1-10 y diversificacion 1-10), que es la forma
# pensada para experimentar: se cambia uno y los nueve se recalculan solos.
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=20.0
MAX_TOTAL_EXPOSURE_PCT=80.0
MAX_OPEN_POSITIONS=5
MAX_DAILY_LOSS_PCT=5.0
MIN_CONVICTION=65
STOP_ATR_MULTIPLE=2.0
MIN_REWARD_RISK=1.5
MIN_ORDER_NOTIONAL=100

# --- Ejecucion --------------------------------------------------------------
# true = analiza y registra en la base de datos pero NO envia ordenes al broker.
DRY_RUN=false
