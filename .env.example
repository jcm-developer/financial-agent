# ---------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena los valores. NUNCA subas `.env` a git.
#
# Aqui solo hay INFRAESTRUCTURA: donde esta la base, la clave del modelo, el
# nivel de log y las horas del planificador. Cosas de la maquina, no del
# experimento.
#
# Los parametros del agente -- riesgo, diversificacion, universo, modelo,
# intervalo de barras, dry_run -- NO estan aqui y no se leen del entorno desde
# F6.4. Viven en la tabla `agent_settings`, uno por perfil, y se editan desde la
# interfaz o con `run.py`. Es la premisa de F6: todo lo que define un
# experimento vive en el perfil, para que dos experimentos se puedan comparar.
#
# Para empezar de cero hacen falta dos cosas, y solo dos:
#
#       copy .env.example .env        y rellenar NVIDIA_API_KEY
#       python run.py new-profile --name europa-01 --market eu --watch 89
# ---------------------------------------------------------------------------


# --- NVIDIA NIM (https://build.nvidia.com -> tu modelo -> Get API Key) ------
# Es la unica variable obligatoria de todo el fichero: los datos de mercado son
# de Yahoo (sin clave) y el broker es el simulador local.
#
# Vale como respaldo para todos los perfiles que usen NIM y no traigan clave
# propia en `agent_settings.llm_api_key`. Con otro proveedor (OpenAI) no sirve, y
# se rechaza al resolver el perfil en vez de fallar con un 401 a mitad de ciclo.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Base de datos (SQLite local) -------------------------------------------
# Ruta al fichero. Se crea solo, junto con las tablas, en el primer arranque.
# En Docker no se toca: la base vive en el volumen con nombre `trading-data`.
DB_PATH=data/trading.db

LOG_LEVEL=INFO

# --- Perfil por defecto -----------------------------------------------------
# Perfil de experimento contra el que operan `cycle` y `status` cuando no se
# pasa `--profile`. Si lo dejas vacio y hay un solo perfil activo, se usa ese;
# con varios activos, el comando exige elegir en lugar de adivinar: operar
# contra el experimento equivocado ensucia dos historicos y no se deshace.
PROFILE=

# --- Controles de la API ----------------------------------------------------
# true = la interfaz muestra los botones de lanzar y parar ciclo. La API sigue
# leyendo el historico en solo lectura y no puede escribir en el ni queriendo
# (F3.3): el boton arranca `run.py cycle` como proceso aparte.
#
# PONLO A false si publicas la API fuera de localhost: no hay autenticacion, y
# quien alcance el puerto podria gastar tu cuota del modelo y mover la cartera.
# No se deduce de la direccion de escucha, porque dentro de Docker hay que
# escuchar en 0.0.0.0 para que el mapeo de puertos funcione y eso no dice nada
# sobre quien puede llegar. Con el mapeo por defecto (127.0.0.1:8000) no hay
# problema.
API_CONTROLS=true

# --- Planificacion (solo la usa el contenedor `scheduler`) ------------------
# ⚠️ El HORARIO NO ESTA AQUI, y desde F6.10 tampoco el perfil.
#
# Que experimentos corren lo dice `profiles.status` y a que horas lo dice
# `agent_settings.cycle_times`, los dos en la base de datos. Se gestionan desde
# la pantalla de Experimentos (activar / pausar) y la de Ajustes (horas), y el
# planificador relee el plan solo: no hay que tocar este fichero ni reiniciar el
# contenedor para cambiar de experimento.
#
# Cada cuanto relee el plan. 60 s esta bien: la consulta es a un SQLite local.
SCHEDULER_REFRESH_SECONDS=60
# true = un ciclo de cada experimento activo al arrancar el contenedor, sin
# esperar a su hora.
RUN_ON_START=false


# ---------------------------------------------------------------------------
# Lo que ya no esta aqui, por si lo buscas
#
# Hasta F8.3 este fichero llevaba una segunda mitad con los ~30 parametros del
# experimento (WATCHLIST, SCREENER_*, RISK_*, LLM_*, BAR_INTERVAL, DRY_RUN...).
# Se han retirado: el ciclo no los lee desde F6.4 y todos tienen valor por
# defecto en el codigo, asi que copiarlos aqui solo servia para creer que
# editarlos cambia algo.
#
#   Para ver los de un perfil:      python run.py profiles
#   Para cambiarlos:                la pantalla de Ajustes, o `run.py`
#   Para crear un perfil nuevo:     python run.py new-profile --market eu
#
# `run.py import-profile` sigue existiendo y sigue funcionando, pero lee el
# `.env` de la version ANTERIOR -- uno que ya trae esas variables escritas-- y
# no esta plantilla. Rellenar treinta variables aqui para luego importarlas
# seria crear un perfil por el camino largo.
# ---------------------------------------------------------------------------
